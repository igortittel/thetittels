---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}/#igor`,
    name: site.person,
    url: `${site.url}/o-nas/`,
    jobTitle: 'Marketingový konzultant',
    worksFor: { '@id': `${site.url}/#org` },
    knowsAbout: [
      'Meta Ads',
      'Google Ads',
      'Google Tag Manager',
      'Google Analytics 4',
      'Meta Conversions API',
      'marketingová automatizácia',
      'WordPress',
      'AI v marketingu',
    ],
  },
];
---

<Base
  title="O nás"
  description="The Tittels sú dvaja ľudia s jedným priezviskom. Viac ako dvanásť rokov v marketingu, skúsenosti z projektov veľkých značiek a pragmatický prístup."
  schema={schema}
>
  <PageHead
    title="Jedno priezvisko, dvaja ľudia."
    lede="The Tittels sme my dvaja. Značku sme pomenovali po sebe, lebo za prácou, ktorú odovzdáme, stojíme menom."
  />

  <section class="section wrap split" aria-labelledby="h-my">
    <h2 id="h-my" data-reveal="mask">Ako pracujeme</h2>
    <div class="prose">
      <p>
        Hovoríme na rovinu a čakáme to isté. Ak niečo máte nastavené dobre, nebudeme to meniť. Ak sa vám niečo
        neoplatí, povieme to, aj keby sme na tom mohli zarobiť. Odporúčame len to, čo sa dá zmerať a obhájiť číslami.
      </p>
      <p>
        Pracujeme najmä pre malé a stredné firmy, ktoré nemajú vlastné marketingové oddelenie alebo v ňom chýba človek
        na konkrétnu vec. Vieme prísť na jeden projekt aj dlhodobo zastúpiť rolu, ktorá v tíme chýba.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="band">
      <div class="wrap split" aria-labelledby="h-igor">
        <h2 id="h-igor" data-reveal="mask">Igor Tittel</h2>
        <div class="prose igor" data-reveal>
          <p>
            „V marketingu pracujem viac ako dvanásť rokov. Začínal som pri kampaniach a postupne som sa dostal k
            všetkému, čo s nimi súvisí: k meraniu, bez ktorého sa kampane nedajú riadiť, k automatizácii, ktorá sa
            stará o zákazníkov po prvom nákupe, a k webom, na ktorých sa to celé odohráva.
          </p>
          <p>
            Za ten čas som pracoval na projektoch veľkých značiek. Naučilo ma to dve veci. Postupy, ktoré fungujú vo
            veľkom, fungujú aj v malom, len ich treba zmenšiť na rozumnú mieru. A väčšina problémov v marketingu nie je
            v nástrojoch, ale v tom, že nikto nepovedal nahlas, čo nefunguje.“
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="cta" data-reveal>
      <a class="btn" href="/mixer/">Zistiť, čím vám vieme byť <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="/kontakt/">Napísať</a>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  h2 {
    font-size: var(--step-2);
    line-height: 1.08;
  }
  .prose {
    font-size: var(--step-1);
    line-height: 1.42;
  }
  .band {
    background: var(--mist);
    padding-block: clamp(3.5rem, 8vw, 8rem);
  }
  .igor {
    font-style: italic;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 1.5rem clamp(2rem, 5vw, 6rem);
    }
  }
</style>
