---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Blog" description="Praktické články o kampaniach, meraní, automatizácii, weboch a AI. Bez teórie, ktorú nevyužijete.">
  <PageHead title="Poznámky z praxe." lede="Píšeme ich tak, aby ste podľa nich vedeli niečo urobiť." />
  <section class="section section--end wrap">
    <ul class="posts">
      {
        posts.map((p) => (
          <li>
            <time class="lab" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
            <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
            <p class="muted">{p.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .posts {
    border-top: 1px solid var(--ink);
  }
  .posts li {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--hair);
  }
  h2 {
    max-width: 20em;
    line-height: 1.08;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
  }
  .posts p {
    max-width: 44em;
  }
  @media (min-width: 56rem) {
    .posts li {
      grid-template-columns: 3fr 9fr;
      column-gap: 3rem;
    }
    time {
      grid-row: 1 / 3;
      padding-top: 0.9em;
    }
  }
</style>
