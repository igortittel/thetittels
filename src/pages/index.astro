---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mixer from '../components/Mixer.astro';
import { services } from '../data/services';
import { site } from '../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'sk' },
];
---

<Base title="Marketing, weby a automatizácia bez omáčky" schema={schema}>
  <section class="hero wrap">
    <h1>Marketing, weby a&nbsp;automatizácia. <span class="mark">Bez omáčky.</span></h1>
    <p class="lede">
      Som Igor Tittel. Dvanásť rokov nastavujem kampane, meranie a weby. Čo vám funguje, nechám tak. Čo nie, opravím.
    </p>
    <div class="hero__mixer">
      <Mixer />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="h-sluzby">
    <h2 id="h-sluzby">Osem vecí, ktoré robím.</h2>
    <ul class="rows">
      {
        services.map((s) => (
          <li>
            <a href={`/sluzby/${s.slug}/`}>
              <span class="rows__name">{s.name}</span>
              <span class="rows__short">{s.short}</span>
              <span class="rows__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="h-pristup">
    <h2 id="h-pristup">Tri veci, ktoré odo mňa čakajte.</h2>
    <dl class="tenets">
      <div>
        <dt>Čo funguje, nemením.</dt>
        <dd>Nový dodávateľ rád začína od nuly, aby bolo vidieť zmenu. Ja najprv zistím, čo zarába, a to nechám bežať.</dd>
      </div>
      <div>
        <dt>Hovorím na rovinu.</dt>
        <dd>Ak sa niečo neoplatí, poviem to hneď. Aj vtedy, keď by som na tom zarobil.</dd>
      </div>
      <div>
        <dt>Rozhodujú čísla.</dt>
        <dd>Pri každom návrhu si vopred povieme, podľa čoho spoznáme, že zabral.</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <div class="band">
      <div class="wrap">
        <p class="band__text">
          Dvanásť rokov som pracoval na projektoch veľkých značiek. Dnes tie isté postupy nastavujem malým a stredným
          firmám, v rozsahu, ktorý im dáva zmysel.
        </p>
        <a class="btn" href="/o-nas/">Kto sú The Tittels <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section wrap split" aria-labelledby="h-blog">
        <h2 id="h-blog">Z blogu.</h2>
        <div>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>
                  <h3>{p.data.title}</h3>
                </a>
                <p>{p.data.description}</p>
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
              </li>
            ))}
          </ul>
          <p class="posts__all">
            <a class="textlink" href="/blog/">Všetky články</a>
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 2rem + 6vw, 7.5rem);
  }
  .hero h1 {
    max-width: 13ch;
  }
  .hero .lede {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .hero__mixer {
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }

  .rows {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    border-top: 1.5px solid var(--ink);
  }
  .rows a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding: clamp(1.1rem, 2.2vw, 1.9rem) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
  }
  .rows a::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--gutter) / 2);
    z-index: -1;
    background: var(--lime);
    border-radius: 12px;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.35s var(--ease);
  }
  .rows a:hover::before,
  .rows a:focus-visible::before {
    transform: scaleY(1);
  }
  .rows__name {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .rows__short {
    color: var(--ink-soft);
    transition: color 0.2s;
  }
  .rows a:hover .rows__short {
    color: var(--ink);
  }
  .rows__arrow {
    font-family: var(--display);
    font-size: var(--step-1);
    transition: transform 0.35s var(--ease);
  }
  .rows a:hover .rows__arrow {
    transform: translateX(6px);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem clamp(2rem, 5vw, 6rem);
    align-items: start;
  }
  .split h2 {
    max-width: 11ch;
  }

  .tenets > div {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .tenets > div:first-child {
    padding-top: 0;
  }
  .tenets dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .tenets dd {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .band {
    background: var(--mist);
    padding-block: clamp(4rem, 9vw, 9rem);
  }
  .band__text {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .band .btn {
    margin-top: 2.5rem;
  }

  .posts li {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .posts li:first-child {
    padding-top: 0;
  }
  .posts a {
    text-decoration: none;
  }
  .posts a:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--lime-deep);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }
  .posts h3 {
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .posts p {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .posts time {
    display: block;
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .posts__all {
    margin-top: 1.75rem;
  }

  @media (max-width: 56rem) {
    .split {
      grid-template-columns: 1fr;
    }
    .split h2 {
      max-width: none;
    }
    .rows a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .rows__short {
      grid-column: 1;
      grid-row: 2;
    }
    .rows__arrow {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
