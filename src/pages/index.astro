---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Machine from '../components/Machine.astro';
import { site } from '../data/site';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, inLanguage: 'sk' },
];
---

<Base title="Biznis ako dobre vyladený stroj" schema={schema}>
  <Machine />

  <section class="inv tenets">
    <div class="wrap">
      <h2 class="visually-hidden">Ako pracujeme</h2>
      <ol>
        <li>
          <h3>Čo funguje, nemeníme.</h3>
          <p>Najprv zistíme, čo zarába, a to necháme bežať. Nezačíname od nuly len preto, aby bolo vidieť zmenu.</p>
        </li>
        <li>
          <h3>Hovoríme na rovinu.</h3>
          <p>Ak sa niečo neoplatí, povieme to hneď. Aj vtedy, keď by sme na tom zarobili.</p>
        </li>
        <li>
          <h3>Rozhodujú čísla.</h3>
          <p>Pri každom návrhu si vopred povieme, podľa čoho spoznáme, že zabral.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section wrap">
    <figure class="quote">
      <blockquote>
        <p>
          „Dvanásť rokov som pracoval na projektoch veľkých značiek. Dnes tie isté postupy nastavujeme malým a stredným
          firmám, v rozsahu, ktorý im dáva zmysel.“
        </p>
      </blockquote>
      <figcaption>
        <span>Igor Tittel</span>
        <a class="textlink" href="/o-nas/">Kto sú The Tittels</a>
      </figcaption>
    </figure>
  </section>

  {
    posts.length > 0 && (
      <section class="section section--end wrap">
        <h2 class="visually-hidden">Z blogu</h2>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <time class="lab" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
              <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              <p class="muted">{p.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="all"><a class="textlink" href="/blog/">Všetky články</a></p>
      </section>
    )
  }
</Base>

<style>
  .tenets {
    padding-block: var(--section);
  }
  .tenets li {
    display: grid;
    gap: 0.6rem 3rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--inv-hair);
  }
  .tenets li:first-child {
    padding-top: 0;
  }
  .tenets li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .tenets h3 {
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.04;
    letter-spacing: -0.022em;
  }
  .tenets p {
    max-width: 30em;
    color: #c9c9c6;
  }

  figure,
  blockquote {
    margin: 0;
  }
  .quote p {
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1.12;
    letter-spacing: -0.022em;
    max-width: 22em;
    text-wrap: balance;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    margin-top: 1.75rem;
  }
  figcaption span {
    font-weight: 620;
  }

  .posts li {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--hair);
  }
  .posts {
    border-top: 1px solid var(--ink);
  }
  .all {
    margin-top: 1.25rem;
  }
  .posts h3 {
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1.08;
    letter-spacing: -0.022em;
    max-width: 22em;
  }
  .posts h3 a {
    text-decoration: none;
  }
  .posts h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
  }
  .posts p {
    max-width: 44em;
  }

  @media (min-width: 56rem) {
    .tenets li {
      grid-template-columns: 7fr 5fr;
      align-items: end;
    }
    .posts li {
      grid-template-columns: 3fr 9fr;
      column-gap: 3rem;
    }
    .posts time {
      grid-row: 1 / 3;
      padding-top: 0.9em;
    }
  }
</style>
