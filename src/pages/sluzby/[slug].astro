---
import Base from '../../layouts/Base.astro';
import Part from '../../components/Part.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service, index) => ({ params: { slug: service.slug }, props: { service, index } }));
}

const { service, index } = Astro.props as { service: Service; index: number };
const others = services.filter((s) => s.slug !== service.slug);
const url = `${site.url}/sluzby/${service.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.lead,
    url,
    provider: { '@id': `${site.url}/#org` },
    areaServed: { '@type': 'Country', name: 'Slovensko' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Služby', item: `${site.url}/sluzby/` },
      { '@type': 'ListItem', position: 2, name: service.name, item: url },
    ],
  },
];
---

<Base title={service.name} description={service.short + ' ' + service.lead.split('. ')[0] + '.'} schema={schema}>
  <header class="head wrap">
    <div class="head__text">
      <p class="lab"><a href="/sluzby/">Služby</a></p>
      <h1>{service.name}</h1>
      <p class="lede">{service.lead}</p>
    </div>
    <Part index={index} tag={service.tag} />
  </header>

  <section class="section wrap">
    <div class="ledger">
      <div class="ledger__head lab"><span>Služba</span><span>Dnes</span><span>Potom</span></div>
      <div class="ledger__row">
        <b>{service.name}</b>
        <span class="now">{service.today}</span>
        <span class="then">{service.after}</span>
      </div>
    </div>
  </section>

  <section class="section wrap split" aria-labelledby="h-kedy">
    <h2 class="lab" id="h-kedy">Kedy to dáva zmysel</h2>
    <ul class="big">
      {service.when.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="h-co">
    <h2 class="lab" id="h-co">Čo dostanete</h2>
    <ul class="plain">
      {service.get.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="h-faq">
    <h2 class="lab" id="h-faq">Časté otázky</h2>
    <dl class="faq">
      {
        service.faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <div class="inv band">
      <div class="wrap">
        <p>Napíšte, ako to máte dnes. Povieme vám, či a ako vieme pomôcť.</p>
        <div class="actions">
          <a class="btn" href="/kontakt/">Napísať</a>
          <a class="btn btn--line" href="/dopyt/">Štyri otázky</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="section section--end wrap" aria-labelledby="h-dalsie">
    <h2 class="visually-hidden" id="h-dalsie">Ďalšie služby</h2>
    <ul class="others">
      {others.map((s) => <li><a href={`/sluzby/${s.slug}/`}>{s.name}</a></li>)}
    </ul>
  </nav>
</Base>

<style>
  .head {
    display: grid;
    gap: 2rem;
    padding-top: clamp(2rem, 1.5rem + 5vw, 6rem);
  }
  .head .lab {
    margin-bottom: 1rem;
  }
  .head .lab a {
    display: inline-block;
    padding-block: 0.9rem;
    margin-block: -0.9rem;
  }
  .head .lede {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }
  .split {
    display: grid;
    gap: 1rem;
    align-items: start;
  }
  .split > .lab {
    padding-top: 0.9rem;
    border-top: 1px solid var(--ink);
  }
  .big li {
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1.1;
    letter-spacing: -0.022em;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hair);
    text-wrap: balance;
  }
  .plain li {
    padding-block: 1rem;
    border-bottom: 1px solid var(--hair);
    font-size: var(--step-1);
    line-height: 1.38;
    max-width: 40em;
  }
  .faq > div {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--hair);
  }
  .big li:first-child,
  .plain li:first-child,
  .faq > div:first-child {
    padding-top: 0.6rem;
  }
  .faq dt {
    font-size: var(--step-1);
    font-weight: 620;
    line-height: 1.22;
  }
  .faq dd {
    margin: 0.5rem 0 0;
    max-width: 40em;
    color: var(--mid);
  }
  .band {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .band p {
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.06;
    letter-spacing: -0.022em;
    max-width: 16em;
    text-wrap: balance;
  }
  .band .actions {
    margin-top: 2.25rem;
  }
  .others {
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }
  .others a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--step-1);
  }
  @media (min-width: 56rem) {
    .head {
      grid-template-columns: 7fr 5fr;
      gap: 3rem;
      align-items: end;
    }
    .split {
      grid-template-columns: 3fr 9fr;
      gap: 3rem;
    }
  }
</style>
