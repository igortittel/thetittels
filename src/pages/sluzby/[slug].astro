---
import Base from '../../layouts/Base.astro';
import Part from '../../components/Part.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service, index) => ({ params: { slug: service.slug }, props: { service, index } }));
}

const { service, index } = Astro.props as { service: Service; index: number };
const next = services[(index + 1) % services.length];
const num = (n: number) => String(n).padStart(2, '0');
const url = `${site.url}/sluzby/${service.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.lead,
    url,
    provider: { '@id': `${site.url}/#org` },
    areaServed: { '@type': 'Country', name: 'Slovensko' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Služby', item: `${site.url}/sluzby/` },
      { '@type': 'ListItem', position: 2, name: service.name, item: url },
    ],
  },
];
---

<Base title={service.name} description={service.short + ' ' + service.lead.split('. ')[0] + '.'} schema={schema}>
  <header class="head wrap">
    <div class="head__text">
      <p class="lab"><a href="/sluzby/">Služby</a></p>
      <h1>{service.name}</h1>
      <p class="lede">{service.lead}</p>
    </div>
    <Part index={index} tag={service.tag} />
  </header>

  <section class="section">
    <div class="inv shift" data-shift>
      <div class="wrap">
        <p class="shift__now">
          <span class="lab">Dnes</span>
          <span><span class="strike" data-strike>{service.today}</span></span>
        </p>
        <i class="shift__line" data-line aria-hidden="true"></i>
        <p class="shift__then">
          <span class="lab">Potom</span>
          <span data-words>
            {service.after.split(' ').map((word) => (
              <>
                <span class="w">{word}</span>{' '}
              </>
            ))}
          </span>
        </p>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="h-kedy">
    <h2 class="leadin" id="h-kedy">Ozvite sa, keď</h2>
    <ol class="cases" data-lit>
      {
        service.when.map((item, i) => (
          <li>
            <span class="lab">{num(i + 1)}</span>
            <p>{item}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="h-co">
    <h2 class="leadin" id="h-co">Na konci máte v rukách</h2>
    <ul class="outs" data-reveal="children">
      {
        service.get.map((item, i) => (
          <li>
            <i class="cross" style="left:-6px;top:-6px" />
            <i class="cross" style="right:-6px;bottom:-6px" />
            <span class="lab">
              {num(i + 1)} / {num(service.get.length)}
            </span>
            <p>{item}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap faq" aria-labelledby="h-faq">
    <h2 id="h-faq">Otázky, ktoré dostávame.</h2>
    <div class="faq__list">
      {
        service.faq.map((f) => (
          <details name="faq">
            <summary>
              <span>{f.q}</span>
              <i aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="inv band">
      <div class="wrap" data-reveal>
        <p>Napíšte, ako to máte dnes. Povieme vám, či a ako vieme pomôcť.</p>
        <div class="actions">
          <a class="btn" href="/kontakt/">Napísať</a>
          <a class="btn btn--line" href="/dopyt/">Štyri otázky</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="wrap" aria-label="Ďalšia služba">
    <a class="next" href={`/sluzby/${next.slug}/`}>
      <span class="lab">Ďalší diel</span>
      <b>{next.name}</b>
      <i aria-hidden="true">→</i>
    </a>
  </nav>
</Base>

<style>
  .head {
    display: grid;
    gap: 2rem;
    padding-top: clamp(2rem, 1.5rem + 5vw, 6rem);
  }
  .head .lab {
    margin-bottom: 1rem;
  }
  .head .lab a {
    display: inline-block;
    padding-block: 0.9rem;
    margin-block: -0.9rem;
  }
  .head .lede {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Dnes → Potom: prvá veta sa pri skrolovaní prečiarkne, druhá sa vypíše. */
  .shift {
    padding-block: clamp(4rem, 12vw, 11rem);
  }
  .shift p {
    display: grid;
    gap: 0.75rem;
    max-width: 15em;
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .shift__now {
    color: var(--inv-mid);
  }
  .strike {
    --strike: 100%;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 56% / var(--strike) 0.055em;
    -webkit-box-decoration-break: slice;
    box-decoration-break: slice;
  }
  .shift__line {
    display: block;
    width: 1px;
    height: clamp(3rem, 8vw, 6rem);
    margin-block: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--paper);
    transform-origin: top;
  }

  .leadin {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--mid);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .cases {
    border-top: 1px solid var(--ink);
  }
  .cases li {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--hair);
  }
  .cases p {
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1.08;
    letter-spacing: -0.022em;
    max-width: 20em;
    text-wrap: balance;
  }

  .outs {
    display: grid;
    gap: 1.25rem;
  }
  .outs li {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-content: space-between;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--ink);
  }
  .outs p {
    font-size: var(--step-1);
    line-height: 1.34;
  }

  .faq {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  .faq__list {
    border-top: 1px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--hair);
    interpolate-size: allow-keywords;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-size: var(--step-1);
    font-weight: 620;
    line-height: 1.22;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary i {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  summary i::before,
  summary i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  summary i::after {
    transform: rotate(90deg);
  }
  details[open] summary i::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 40em;
    padding-bottom: 1.5rem;
    color: var(--mid);
  }
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.45s var(--ease),
      content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }

  .band {
    padding-block: clamp(3.5rem, 8vw, 7rem);
  }
  .band p {
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.06;
    letter-spacing: -0.022em;
    max-width: 16em;
    text-wrap: balance;
  }
  .band .actions {
    margin-top: 2.25rem;
  }

  .next {
    position: relative;
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    text-decoration: none;
  }
  .next b {
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.04;
    letter-spacing: -0.022em;
    padding-right: 1.2em;
  }
  .next i {
    position: absolute;
    right: 0;
    bottom: clamp(2.5rem, 6vw, 5rem);
    font-size: var(--step-3);
    font-style: normal;
    line-height: 1.04;
    transition: transform 0.4s var(--ease);
  }
  .next:hover i {
    transform: translateX(0.5rem);
  }

  @media (min-width: 56rem) {
    .head {
      grid-template-columns: 7fr 5fr;
      gap: 3rem;
      align-items: end;
    }
    .cases li {
      grid-template-columns: 3fr 9fr;
      gap: 3rem;
      align-items: baseline;
    }
    .outs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .outs li {
      min-height: 17rem;
    }
    .faq {
      grid-template-columns: 4fr 8fr;
      gap: 3rem;
    }
    .faq h2 {
      position: sticky;
      top: 6rem;
    }
  }
</style>
