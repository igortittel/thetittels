---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { services, type Service } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug);
const url = `${site.url}/sluzby/${service.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.lead,
    url,
    provider: { '@id': `${site.url}/#org` },
    areaServed: { '@type': 'Country', name: 'Slovensko' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Služby', item: `${site.url}/sluzby/` },
      { '@type': 'ListItem', position: 2, name: service.name, item: url },
    ],
  },
];
---

<Base title={service.name} description={service.short + ' ' + service.lead.split('. ')[0] + '.'} schema={schema}>
  <PageHead title={service.name} lede={service.lead}>
    <p class="back"><a href="/sluzby/">← Všetky služby</a></p>
  </PageHead>

  <section class="section wrap split" aria-labelledby="h-kedy">
    <h2 id="h-kedy" data-reveal="mask">Kedy to dáva zmysel</h2>
    <ul class="big">
      {service.when.map((item, i) => <li data-reveal style={`--i:${i}`}>{item}</li>)}
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="h-co">
    <h2 id="h-co" data-reveal="mask">Čo dostanete</h2>
    <ul class="plain">
      {service.get.map((item, i) => <li data-reveal style={`--i:${i}`}>{item}</li>)}
    </ul>
  </section>

  <section class="section wrap split" aria-labelledby="h-faq">
    <h2 id="h-faq" data-reveal="mask">Časté otázky</h2>
    <dl class="faq">
      {
        service.faq.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section">
    <div class="band">
      <div class="wrap band__in">
        <p data-reveal>Napíšte, ako to máte dnes. Povieme vám, či a ako vieme pomôcť.</p>
        <div class="band__btns">
          <a class="btn" href="/kontakt/">Napísať <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/mixer/">Prejsť mixérom</a>
        </div>
      </div>
    </div>
  </section>

  <nav class="section wrap" aria-labelledby="h-dalsie">
    <h2 id="h-dalsie" class="small">Ďalšie služby</h2>
    <ul class="others">
      {others.map((s) => <li><a href={`/sluzby/${s.slug}/`}>{s.name}</a></li>)}
    </ul>
  </nav>
</Base>

<style>
  .back {
    order: -1;
    margin-bottom: 1.5rem;
    font-size: var(--step--1);
  }
  :global(.ph) {
    display: flex;
    flex-direction: column;
  }
  .back a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .back a:hover {
    color: var(--ink);
  }
  .split {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  h2 {
    font-size: var(--step-2);
    line-height: 1.08;
  }
  .big li {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-2);
    line-height: 1.15;
    letter-spacing: -0.02em;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
    text-wrap: balance;
  }
  .big li:first-child,
  .plain li:first-child,
  .faq > div:first-child {
    padding-top: 0;
  }
  .plain li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 44ch;
  }
  .faq > div {
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .faq dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .faq dd {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .band {
    background: var(--lime);
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }
  .band__in {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem 3rem;
  }
  .band p {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-3);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 20ch;
    text-wrap: balance;
  }
  .band__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .small {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.25rem;
  }
  .others a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 1.5rem clamp(2rem, 5vw, 6rem);
    }
  }
</style>
