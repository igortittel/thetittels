---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `${site.url}/sluzby/${s.slug}/`,
    })),
  },
];
---

<Base
  title="Služby"
  description="Platené kampane, tracking, marketingová automatizácia, omnichannel, automatizácia procesov, weby, brand a AI. Pri každej službe, čo máte dnes a čo budete mať potom."
  schema={schema}
>
  <PageHead
    title="Osem dielov jedného stroja."
    lede="Každý si viete objednať samostatne. Najviac spravia, keď na seba nadväzujú: kampane potrebujú meranie, automatizácia potrebuje dáta a web potrebuje oboje."
  />
  <section class="section">
    <ol class="rows">
      {
        services.map((s, i) => (
          <li>
            <a class="row" href={`/sluzby/${s.slug}/`}>
              <span class="row__n lab">{String(i + 1).padStart(2, '0')}</span>
              <h2>{s.name}</h2>
              <p class="row__now"><span class="lab">Dnes</span>{s.today}</p>
              <p class="row__then"><span class="lab">Potom</span>{s.after}</p>
              <span class="row__cta">Pozrieť službu<i aria-hidden="true">→</i></span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <section class="section section--end wrap">
    <p class="lede">Neviete, ktorý diel je váš? Odpovedzte na štyri krátke otázky a povieme vám, v akej role vám vieme pomôcť.</p>
    <div class="actions"><a class="btn" href="/dopyt/">Začať</a><a class="textlink" href="/kontakt/">Alebo rovno napísať</a></div>
  </section>
</Base>

<style>
  .actions {
    margin-top: 2rem;
  }
  .rows {
    border-top: 1px solid var(--ink);
  }
  .row {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem var(--gutter) 2rem;
    border-bottom: 1px solid var(--hair);
    text-decoration: none;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .row h2 {
    font-size: var(--step-2);
  }
  .row p {
    display: grid;
    gap: 0.2rem;
    max-width: 26em;
  }
  .row__now {
    color: var(--mid);
  }
  .row__then {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  /* Na mobile je to tlačidlo, na širokej obrazovke šípka na konci riadku. */
  .row__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    margin-top: 0.5rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--ink);
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .row__cta i {
    font-style: normal;
    transition: transform 0.35s var(--ease);
  }
  .row:active .row__cta {
    background: var(--ink);
    color: var(--paper);
  }
  @media (hover: hover) {
    .row:hover {
      background: var(--ink);
      color: var(--paper);
    }
    .row:hover .lab,
    .row:hover .row__now {
      color: var(--inv-mid);
    }
    .row:hover .row__cta {
      border-color: var(--paper);
      background: var(--paper);
      color: var(--ink);
    }
    .row:hover .row__cta i {
      transform: translateX(0.35rem);
    }
  }
  @media (min-width: 62rem) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 4fr) minmax(0, 3fr) minmax(0, 4fr) auto;
      gap: 2rem;
      align-items: center;
      padding-block: 2.25rem;
    }
    .row__cta {
      margin-top: 0;
      white-space: nowrap;
    }
  }
</style>
