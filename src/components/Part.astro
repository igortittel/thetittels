---
// Jeden diel stroja pre stránku služby.
interface Props {
  index: number;
  tag: string;
}
const { index, tag } = Astro.props;
---

<div class="part" data-part={index}>
  <canvas aria-hidden="true"></canvas>
  <span class="lab t2">{tag}</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-part]').forEach(async (host) => {
    if (!('ResizeObserver' in window)) return;
    const { mountPart } = await import('../scripts/machine');
    if (mountPart(host.querySelector('canvas')!, host, Number(host.dataset.part))) host.classList.add('is-live');
  });
</script>

<style>
  .part {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    border: 1px solid var(--hair);
    touch-action: pan-y;
    cursor: grab;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .t2 {
    position: absolute;
    left: 0.9rem;
    top: 0.75rem;
  }
</style>
