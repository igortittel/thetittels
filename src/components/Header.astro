---
import { site } from '../data/site';
const path = Astro.url.pathname;
---

<header class="head">
  <div class="head__in">
    <a class="logo" href="/" aria-label={`${site.name}, domov`}>{site.name}</a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" class="nav" aria-label="Hlavná navigácia">
      <ul>
        {
          site.nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    transition: box-shadow 0.2s;
  }
  .head:global(.is-scrolled) {
    box-shadow: 0 1px 0 var(--ink);
  }
  .head__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
    padding-inline: var(--gutter);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 620;
    font-size: 1.125rem;
    text-decoration: none;
  }
  .menu {
    min-height: 2.75rem;
    padding: 0 0 0 1rem;
    border: 0;
    background: none;
    font-size: 1.0625rem;
    cursor: pointer;
  }
  .menu[aria-expanded='true'] {
    text-decoration: underline;
    text-underline-offset: 0.24em;
  }
  .nav {
    display: none;
    position: absolute;
    inset: 100% 0 auto 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }
  .nav:global(.is-open) {
    display: block;
  }
  .nav a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    font-size: var(--step-2);
    letter-spacing: -0.022em;
    text-decoration: none;
    border-top: 1px solid var(--hair);
  }
  .nav a[aria-current='page'] {
    font-weight: 620;
  }
  @media (min-width: 46rem) {
    .menu {
      display: none;
    }
    .nav {
      display: block;
      position: static;
      padding: 0;
      border: 0;
    }
    .nav ul {
      display: flex;
      gap: clamp(1.25rem, 2.6vw, 2.5rem);
    }
    .nav a {
      display: inline-flex;
      min-height: 2.75rem;
      font-size: 1.0625rem;
      letter-spacing: 0;
      border: 0;
    }
    .nav a:hover,
    .nav a[aria-current='page'] {
      font-weight: 400;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.3em;
    }
  }
</style>
