---
// Úvod webu: osem služieb ako jeden stroj. Bez JS je to nadpis a obyčajný zoznam;
// s JS sa sekcia pri skrolovaní drží na mieste a stroj sa rozkladá diel po diele.
import { services } from '../data/services';
---

<section class="mech" data-mech>
  <div class="stage">
    <div class="panel">
      <div class="items">
        <div class="item is-on" data-item="-1">
          <h1>Biznis funguje ako dobre vyladený stroj.</h1>
          <p class="sub">
            Osem dielov, ktoré do seba zapadajú. Keď jeden chýba alebo drhne, ostatné sa točia naprázdno. Staviame ich,
            ladíme a opravujeme.
          </p>
          <div class="actions">
            <a class="btn" href="/kontakt/">Napísať</a>
            <a class="textlink" href="/sluzby/">Všetky služby</a>
          </div>
        </div>
        {
          services.map((s, i) => (
            <article class="item" data-item={i} data-tagname={s.tag}>
              <h2><a href={`/sluzby/${s.slug}/`}>{s.name}</a></h2>
              <dl>
                <div><dt class="lab">Dnes</dt><dd class="muted">{s.today}</dd></div>
                <div><dt class="lab">Potom</dt><dd>{s.after}</dd></div>
              </dl>
            </article>
          ))
        }
        <div class="item" data-item="8">
          <h2>Osem dielov. Jeden stroj.</h2>
          <p class="sub">
            Každý diel si viete objednať samostatne. Najviac spravia, keď bežia spolu a jeden človek vie, ako do seba
            zapadajú.
          </p>
          <div class="actions">
            <a class="btn" href="/kontakt/">Napísať</a>
            <a class="textlink" href="/dopyt/">Zistiť, čím vám vieme byť</a>
          </div>
        </div>
      </div>
      <ol class="rail" data-rail>
        {
          services.map((s, i) => (
            <li>
              <button type="button" data-go={i} aria-label={s.name} />
            </li>
          ))
        }
      </ol>
    </div>
    <div class="view" data-view>
      <canvas aria-hidden="true"></canvas>
      <div class="tag" data-tag><i></i><span></span></div>
      <p class="scrollhint lab" data-hint>Skrolujte, stroj sa rozloží</p>
    </div>
  </div>
</section>
<script is:inline>
  // Rozloženie pre stroj sa zapne ešte pred prvým vykreslením, aby stránka nepreskočila.
  if ('ResizeObserver' in window && 'IntersectionObserver' in window) {
    document.querySelector('[data-mech]').classList.add('is-live');
  }
</script>

<script>
  const section = document.querySelector<HTMLElement>('[data-mech].is-live');
  if (section) {
    const view = section.querySelector<HTMLElement>('[data-view]')!;
    const canvas = view.querySelector('canvas')!;
    const tag = section.querySelector<HTMLElement>('[data-tag]')!;
    const tagText = tag.querySelector('span')!;
    const hint = section.querySelector<HTMLElement>('[data-hint]')!;
    const items = [...section.querySelectorAll<HTMLElement>('[data-item]')];
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-go]')];

    const progress = () => {
      const rect = section.getBoundingClientRect();
      const span = rect.height - window.innerHeight;
      return span > 0 ? Math.max(0, Math.min(1, -rect.top / span)) : 0;
    };

    import('../scripts/machine')
      .then(({ mountAssembly }) => {
        const ok = mountAssembly({
          canvas,
          host: view,
          progress,
          onStep(step) {
            items.forEach((el) => {
              const on = Number(el.dataset.item) === step;
              el.classList.toggle('is-on', on);
              if (on) {
                el.classList.remove('swap');
                void el.offsetWidth;
                el.classList.add('swap');
              }
            });
            buttons.forEach((b, i) => b.setAttribute('aria-current', String(i === step)));
            hint.hidden = step >= 0;
          },
          onAnchor(point, step) {
            if (!point) {
              tag.style.opacity = '0';
              return;
            }
            const width = view.clientWidth;
            tagText.textContent = items.find((el) => Number(el.dataset.item) === step)?.dataset.tagname ?? '';
            // Popisok sa drží pri diele, ale nikdy nevyjde za okraj.
            const x = Math.min(point.x + Math.min(width * 0.2, 110), width - tag.offsetWidth - 12);
            tag.style.transform = `translate(${Math.round(x)}px, ${Math.round(point.y - 8)}px)`;
            tag.style.opacity = '1';
          },
        });
        if (!ok) section.classList.remove('is-live');
      })
      .catch(() => section.classList.remove('is-live'));

    buttons.forEach((button, i) =>
      button.addEventListener('click', () => {
        const top = section.getBoundingClientRect().top + window.scrollY;
        const span = section.offsetHeight - window.innerHeight;
        window.scrollTo({ top: top + span * (0.08 + ((i + 0.5) / buttons.length) * 0.84) });
      }),
    );
  }
</script>

<style>
  /* Bez JS: nadpis a zoznam služieb */
  .view,
  .rail {
    display: none;
  }
  .panel {
    padding: clamp(2rem, 1.5rem + 5vw, 6rem) var(--gutter) 0;
  }
  .item {
    display: grid;
    gap: 0.9rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--hair);
  }
  .item:first-child {
    padding-top: 0;
  }
  h1,
  .item h2 {
    font-size: var(--step-3);
    font-weight: 360;
    line-height: 1.04;
    letter-spacing: -0.022em;
    max-width: 12em;
  }
  .item h2 a {
    text-decoration: none;
  }
  .item h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .sub {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 28em;
  }
  dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }
  dd {
    margin: 0.15rem 0 0;
    font-size: var(--step-1);
    line-height: 1.34;
    max-width: 24em;
  }
  .actions {
    margin-top: 0.5rem;
  }

  /* S JS: sekcia sa drží na mieste, text hore, stroj pod ním */
  .mech:global(.is-live) {
    height: 760vh;
    margin-top: -3.75rem;
  }
  .mech:global(.is-live) .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
  }
  .mech:global(.is-live) .panel {
    display: grid;
    gap: 1rem;
    padding: 5rem var(--gutter) 0.75rem;
    min-height: 15.5rem;
    align-content: start;
  }
  .mech:global(.is-live) .item {
    display: none;
    padding: 0;
    border: 0;
    gap: 0.75rem;
  }
  .mech:global(.is-live) .item:global(.is-on) {
    display: grid;
  }
  .mech:global(.is-live) .rail {
    display: flex;
    gap: 4px;
  }
  .rail li {
    flex: 1;
    max-width: 3.5rem;
  }
  .rail button {
    display: block;
    width: 100%;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: linear-gradient(var(--hair), var(--hair)) no-repeat 0 50% / 100% 1px;
    cursor: pointer;
  }
  .rail button:hover,
  .rail button[aria-current='true'] {
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 100% 3px;
  }
  .mech:global(.is-live) .view {
    display: block;
    position: relative;
    min-height: 0;
    touch-action: pan-y;
    cursor: grab;
  }
  .view canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tag {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    will-change: transform;
  }
  .tag i {
    width: clamp(28px, 6vw, 90px);
    height: 1px;
    background: var(--ink);
  }
  .tag span {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .scrollhint {
    position: absolute;
    left: var(--gutter);
    bottom: 1rem;
    pointer-events: none;
  }

  @media (max-width: 59.99rem) {
    .mech:global(.is-live) h1,
    .mech:global(.is-live) .item h2 {
      font-size: clamp(1.9rem, 1rem + 4.4vw, 3rem);
    }
    .mech:global(.is-live) .sub,
    .mech:global(.is-live) dd {
      font-size: var(--step-0);
    }
    .mech:global(.is-live) .item:first-child .actions .textlink {
      display: none;
    }
  }
  @media (min-width: 60rem) {
    .mech:global(.is-live) .stage {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    }
    .mech:global(.is-live) .panel {
      grid-template-rows: minmax(0, 1fr) auto;
      padding: 6.5rem 3vw 2rem var(--gutter);
      min-height: 0;
    }
    .mech:global(.is-live) .items {
      display: grid;
      align-content: center;
    }
    .mech:global(.is-live) .item {
      gap: 1.5rem;
    }
    dl {
      gap: 1.25rem;
    }
  }
</style>
