---
import { problems } from '../data/mixer';
import { services } from '../data/services';
const names = Object.fromEntries(services.map((s) => [s.slug, s.name]));
---

<form class="mixer" action="/mixer/" method="get" data-mixer>
  <fieldset class="mixer__in">
    <legend>Označte, čo u vás práve platí.</legend>
    <div class="chips">
      {
        problems.map((p) => (
          <label class="chip">
            <input type="checkbox" name="p" value={p.id} />
            <span>{p.label}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="mixer__out" aria-live="polite">
    <div data-empty>
      <p class="mixer__idle">Vyberte aspoň jednu vec a hneď uvidíte, čím vám vieme byť.</p>
    </div>
    <div data-result hidden>
      <p class="mixer__pre">Vieme byť váš</p>
      <p class="mixer__role" data-role></p>
      <p class="mixer__text" data-text></p>
      <ul class="mixer__svc" data-services></ul>
    </div>
    <button class="btn btn--lime" type="submit">
      Pokračovať, zaberie to dve minúty <span class="arrow" aria-hidden="true">→</span>
    </button>
  </div>
  <div class="mixer__dock" data-dock hidden>
    <p><span>Vieme byť váš</span> <strong data-dock-role></strong></p>
    <button class="btn btn--lime" type="submit" aria-label="Pokračovať do mixéra">
      Ďalej <span class="arrow" aria-hidden="true">→</span>
    </button>
  </div>
  <script type="application/json" data-names set:html={JSON.stringify(names)} />
</form>

<script>
  import { recommend } from '../scripts/recommend';

  document.querySelectorAll<HTMLFormElement>('[data-mixer]').forEach((form) => {
    const names = JSON.parse(form.querySelector('[data-names]')!.textContent || '{}');
    const empty = form.querySelector<HTMLElement>('[data-empty]')!;
    const result = form.querySelector<HTMLElement>('[data-result]')!;
    const role = form.querySelector<HTMLElement>('[data-role]')!;
    const text = form.querySelector<HTMLElement>('[data-text]')!;
    const list = form.querySelector<HTMLElement>('[data-services]')!;
    const out = form.querySelector<HTMLElement>('.mixer__out')!;
    const dock = form.querySelector<HTMLElement>('[data-dock]')!;
    const dockRole = form.querySelector<HTMLElement>('[data-dock-role]')!;
    let last = '';
    let outVisible = false;
    let hasRec = false;

    // Na mobile je výsledok pod zoznamom, preto ho kým nie je v zábere drží lišta pri spodku.
    const syncDock = () => (dock.hidden = !hasRec || outVisible);
    new IntersectionObserver(
      ([entry]) => {
        outVisible = entry.isIntersecting;
        syncDock();
      },
      { threshold: 0.35 },
    ).observe(out);

    const update = () => {
      const ids = [...form.querySelectorAll<HTMLInputElement>('input[name="p"]:checked')].map((i) => i.value);
      const rec = recommend(ids);
      empty.hidden = !!rec;
      result.hidden = !rec;
      hasRec = !!rec;
      syncDock();
      if (!rec) {
        last = '';
        return;
      }
      dockRole.textContent = rec.role.title;
      if (rec.role.id !== last) {
        role.textContent = rec.role.title;
        text.textContent = rec.role.text;
        role.classList.remove('is-in');
        void role.offsetWidth;
        role.classList.add('is-in');
        last = rec.role.id;
      }
      list.replaceChildren(
        ...rec.services.map((slug) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/sluzby/${slug}/`;
          a.textContent = names[slug] ?? slug;
          li.append(a);
          return li;
        }),
      );
    };

    form.addEventListener('change', update);
    update();
  });
</script>

<style>
  .mixer {
    display: grid;
    gap: 1.75rem;
    position: relative;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
    margin-bottom: 1.1rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .mixer__out {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
  }
  .mixer__out :global(:focus-visible) {
    outline-color: var(--lime);
  }
  .mixer__idle {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 400;
    font-style: italic;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #a9b5ad;
    text-wrap: balance;
  }
  .mixer__pre {
    color: #a9b5ad;
  }
  .mixer__role {
    margin-top: 0.25rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--lime);
    text-wrap: balance;
  }
  .mixer__role:global(.is-in) {
    animation: role-in 0.7s var(--ease) both;
  }
  @keyframes role-in {
    from {
      clip-path: inset(0 100% 0 0);
      filter: blur(8px);
      transform: translateX(-0.25em);
    }
    to {
      clip-path: inset(-10% -5% -20% 0);
      filter: blur(0);
      transform: none;
    }
  }
  .mixer__text {
    margin-top: 1rem;
    max-width: 34ch;
  }
  .mixer__svc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }
  .mixer__svc :global(a) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: #d5ddd7;
  }
  .mixer__svc :global(a:hover) {
    color: var(--lime);
  }
  .mixer__out .btn {
    align-self: stretch;
    justify-content: space-between;
    text-align: left;
  }

  .mixer__dock {
    position: sticky;
    bottom: 0.75rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: -1rem;
    padding: 0.6rem 0.6rem 0.6rem 1.1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 14px 34px -10px rgb(13 18 15 / 0.45);
    animation: dock-in 0.5s var(--ease) both;
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  .mixer__dock p {
    min-width: 0;
    font-size: var(--step--1);
    line-height: 1.2;
  }
  .mixer__dock span {
    display: block;
    color: #a9b5ad;
  }
  .mixer__dock strong {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--step-0);
    color: var(--lime);
  }
  .mixer__dock .btn {
    flex: none;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
  }

  @media (min-width: 60rem) {
    .mixer {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 3vw, 3rem);
      align-items: stretch;
    }
    .mixer__out {
      min-height: 23rem;
      padding: clamp(1.75rem, 3vw, 2.5rem);
    }
    .mixer__out .btn {
      align-self: flex-start;
      justify-content: flex-start;
    }
    .mixer__dock {
      display: none;
    }
  }
</style>
