---
// Referencie: značky, weby a nástroje. Dáta sú v src/data/proof.ts.
import { clients, sites, tools } from '../data/proof';
---

<section class="section wrap" aria-labelledby="h-clients">
  <h2 class="intro" id="h-clients">Značky, pre ktoré sme pracovali alebo pracujeme.</h2>
  <ul class="clients" data-reveal="children">
    {clients.map((name) => <li>{name}</li>)}
  </ul>
</section>

<section class="section" aria-labelledby="h-tools">
  <h2 class="intro wrap" id="h-tools">Nástroje, ktoré nám prešli rukami.</h2>
  <div class="tape">
    <ul class="tape__run">
      {tools.map((name) => <li>{name}</li>)}
    </ul>
    <ul class="tape__run" aria-hidden="true">
      {tools.map((name) => <li>{name}</li>)}
    </ul>
  </div>
</section>

<section class="section section--end wrap" aria-labelledby="h-sites">
  <h2 class="intro" id="h-sites">Weby, ktoré sme postavili.</h2>
  <ul class="sites" data-reveal="children">
    {
      sites.map((site) => (
        <li>
          {site.href ? (
            <a class="site" href={site.href} target="_blank" rel="noopener">
              <i class="cross" style="left:-6px;top:-6px" />
              <i class="cross" style="right:-6px;bottom:-6px" />
              <span class="lab">{site.note}</span>
              <b>{site.name}</b>
              <span class="go" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="site site--soon">
              <i class="cross" style="left:-6px;top:-6px" />
              <i class="cross" style="right:-6px;bottom:-6px" />
              <span class="lab">{site.note}</span>
              <b>{site.name}</b>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .intro {
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--mid);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .clients {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }
  .clients li {
    display: flex;
    align-items: flex-end;
    min-height: clamp(5.5rem, 14vw, 11rem);
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--hair);
    font-size: clamp(1.35rem, 0.9rem + 2.4vw, 3.25rem);
    font-weight: 360;
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .clients li:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--hair);
  }

  /* Bežiaci pás s nástrojmi */
  .tape {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--ink);
  }
  .tape__run {
    display: flex;
    flex: none;
    animation: tape 36s linear infinite;
  }
  .tape:hover .tape__run {
    animation-play-state: paused;
  }
  .tape li {
    display: flex;
    align-items: center;
    padding-block: clamp(1.1rem, 2.4vw, 2rem);
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1;
    letter-spacing: -0.022em;
    white-space: nowrap;
  }
  .tape li::after {
    content: '';
    width: 0.32em;
    height: 0.32em;
    margin-inline: clamp(1.25rem, 3vw, 3rem);
    border: 1px solid var(--ink);
    transform: rotate(45deg);
  }
  @keyframes tape {
    to {
      transform: translateX(-100%);
    }
  }

  .sites {
    display: grid;
    gap: 1.25rem;
  }
  .site {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: space-between;
    min-height: clamp(9rem, 22vw, 15rem);
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--ink);
    text-decoration: none;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .site b {
    font-size: var(--step-2);
    font-weight: 360;
    line-height: 1.04;
    letter-spacing: -0.022em;
    overflow-wrap: anywhere;
  }
  .site .go {
    position: absolute;
    right: clamp(1rem, 2.5vw, 1.75rem);
    top: clamp(0.8rem, 2vw, 1.4rem);
    font-size: var(--step-1);
    transition: transform 0.3s var(--ease);
  }
  a.site:hover {
    background: var(--ink);
    color: var(--paper);
  }
  a.site:hover .lab {
    color: var(--inv-mid);
  }
  a.site:hover .go {
    transform: translate(0.2rem, -0.2rem);
  }
  .site--soon {
    border-style: dashed;
    border-color: var(--mid);
    color: var(--mid);
  }

  @media (min-width: 56rem) {
    .clients {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .clients li:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
    .clients li:not(:nth-child(3n + 1)) {
      padding-left: 1.5rem;
      border-left: 1px solid var(--hair);
    }
    .sites {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tape {
      overflow-x: auto;
    }
    .tape__run {
      animation: none;
    }
    .tape__run[aria-hidden] {
      display: none;
    }
  }
</style>
