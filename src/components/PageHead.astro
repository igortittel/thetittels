---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="ph wrap">
  <h1 class="rise">{title}</h1>
  {lede && <p class="lede rise" style="--i:1">{lede}</p>}
  <slot />
</header>

<style>
  .ph {
    padding-top: clamp(2.25rem, 1.5rem + 5vw, 6.5rem);
  }
  h1 {
    max-width: 16ch;
  }
  .lede {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }
</style>
