# Google Tag Manager (voliteľné). Bez hodnoty sa GTM ani cookie lišta nenačíta.
PUBLIC_GTM_ID=

# Odosielanie dopytov z formulárov cez Resend (https://resend.com).
RESEND_API_KEY=
# Odosielateľ: adresa na doméne overenej v Resend, napr. web@thetittels.sk
LEAD_FROM_EMAIL=
# Kam dopyty chodia. Bez hodnoty sa použije e-mail zo src/data/site.ts.
LEAD_TO_EMAIL=
